# .env.sample - Environment variables for Task Scheduler

# --- API Authentication ---
# API key required to access the backend API (X-API-Key header).
# Shell/Pythonジョブとして任意コマンドを実行できるAPIのため、
# api.host を 127.0.0.1 以外(例: 0.0.0.0)にする場合は必ず設定すること。
# Leave unset only when the API is bound to 127.0.0.1 (local-only access).
# API_KEY="your_random_secret_api_key"

# --- Email Settings ---
# The user account for SMTP authentication (e.g., your email address).
# This can be used to override the value in config.yaml.
SMTP_USER="your_email@example.com"

# The password for the email sender account.
# This should be kept secret and not committed to version control.
EMAIL_SENDER_PASSWORD="your_secure_email_password"
# Optional: Override SMTP server from config.yaml
# EMAIL_SMTP_SERVER="smtp.override.com"
# Optional: Override SMTP port from config.yaml
# EMAIL_SMTP_PORT="587"

# --- Project Root (Optional) ---
# Uncomment and set this if you need to explicitly define the project root directory.
# By default, the application determines the project root dynamically.
# TASK_SCHEDULER_PROJECT_ROOT="/path/to/your/project/root"

# --- Database Settings (for remote databases) ---
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/database_name"
# Or individual components:
# DB_USERNAME="your_db_user"
# DB_PASSWORD="your_db_password"
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="task_scheduler_db"

# --- API Keys for External Services (Examples) ---
# If integrating with Slack for notifications:
# SLACK_API_TOKEN="xoxb-your-slack-bot-token"
# If integrating with Twilio for SMS notifications:
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# --- Debugging and Logging Settings ---
# Set to 'True' to enable debug mode (e.g., for more verbose logging).
# APP_DEBUG_MODE="True"
# Set the desired logging level (e.g., INFO, DEBUG, WARNING, ERROR).
# LOG_LEVEL="INFO"
# Specify a custom path for log files.
# LOG_FILE_PATH="/var/log/task_scheduler/app.log"

# --- Application-Specific Settings (Examples) ---
# Maximum number of concurrent jobs to run.
# MAX_CONCURRENT_JOBS="10"
# Timeout in seconds for individual tasks.
# TASK_TIMEOUT_SECONDS="300"
